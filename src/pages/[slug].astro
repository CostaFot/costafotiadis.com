---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ShareBar from '../components/ShareBar.astro';
import Claps from '../components/Claps.astro';
import { SITE, RESERVED, splitTitle, excerptOf, fmtDate, sameDay, readingTime, tagSlug, byNewest } from '../lib/site';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(byNewest);
  const pages = await getCollection('pages');
  const seen = new Map<string, string>();
  const claim = (slug: string, file: string) => {
    if (RESERVED.has(slug)) throw new Error(`${file}: slug "${slug}" is a reserved path`);
    if (seen.has(slug)) throw new Error(`${file} and ${seen.get(slug)} both use slug "${slug}"`);
    seen.set(slug, file);
  };
  return [
    ...posts.map((entry, i) => {
      claim(entry.data.slug, entry.id);
      return { params: { slug: entry.data.slug }, props: { entry, kind: 'post', newer: posts[i - 1], older: posts[i + 1] } };
    }),
    ...pages.map((entry) => {
      claim(entry.data.slug, entry.id);
      return { params: { slug: entry.data.slug }, props: { entry, kind: 'page' } };
    }),
  ];
}

type Props =
  | { entry: CollectionEntry<'posts'>; kind: 'post'; newer?: CollectionEntry<'posts'>; older?: CollectionEntry<'posts'> }
  | { entry: CollectionEntry<'pages'>; kind: 'page' };

const props = Astro.props as Props;
const { entry, kind } = props;
const { Content } = await render(entry);
const { series, headline, mark } = kind === 'post' ? splitTitle(entry.data.title) : { headline: entry.data.title, mark: '' };
const canonical = `${SITE.url}/${entry.data.slug}/`;
const description = kind === 'post' ? excerptOf(entry) || SITE.description : SITE.description;
const og = entry.data.feature_image ? await getImage({ src: entry.data.feature_image, width: 1200, format: 'jpg' }) : null;
const ogUrl = og ? new URL(og.src, SITE.url).href : undefined;
const updated = entry.data.date_updated && !sameDay(entry.data.date_updated, entry.data.date_published) ? entry.data.date_updated : undefined;
---
<Base title={entry.data.title} description={description} image={ogUrl} type={kind === 'post' ? 'article' : 'website'}
  published={kind === 'post' ? entry.data.date_published : undefined} updated={kind === 'post' ? updated : undefined}>
  <article data-pagefind-body data-type={kind}>
    <header class="post-head" class:list={{ 'sr-only': kind === 'page' && entry.data.portrait }}>
      {series && <p class="eyebrow">{series}</p>}
      <h1>{headline}</h1>
      {kind === 'post' && (
        <p class="meta" data-pagefind-ignore>
          <time datetime={entry.data.date_published.toISOString()}>{fmtDate(entry.data.date_published)}</time>
          {updated && <span>updated {fmtDate(updated)}</span>}
          <span>{readingTime(entry.body)} min read</span>
          {entry.data.tags.map((t) => <a class="tag" href={`/tag/${tagSlug(t)}/`}>{t.toLowerCase()}</a>)}
        </p>
      )}
      {entry.data.feature_image && kind === 'post' && (
        <figure class="hero">
          <Image src={entry.data.feature_image} alt="" width={1200} densities={[1, 1.5]} loading="eager" fetchpriority="high" />
        </figure>
      )}
    </header>

    {kind === 'page' && entry.data.portrait && (
      <Image class="portrait" src={entry.data.portrait} alt="" width={144} height={144} densities={[1, 2]} loading="eager" />
    )}

    <div class="prose">
      <Content />
    </div>

    {kind === 'post' && (
      <footer class="post-foot">
        <ShareBar title={entry.data.title} url={canonical} />
        <Claps url={`${SITE.url}/${entry.data.slug}`} />
      </footer>
    )}
  </article>

  {kind === 'post' && (props.newer || props.older) && (
    <nav class="post-nav" aria-label="More posts">
      <div>{props.newer && <a href={`/${props.newer.data.slug}/`}><span class="k">← newer</span>{props.newer.data.title}</a>}</div>
      <div class="older">{props.older && <a href={`/${props.older.data.slug}/`}><span class="k">older →</span>{props.older.data.title}</a>}</div>
    </nav>
  )}
</Base>
