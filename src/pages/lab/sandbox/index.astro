---
import Lab from '../../../layouts/Lab.astro';

export const experiment = {
  title: 'Sandbox',
  description: 'Falling-sand toy. Draw elements and let them interact — water flows, plants grow, fire burns.',
  date: '2026-08-22',
};
---

<Lab {...experiment}>
  <div class="toolbar" id="toolbar">
    <button data-mat="1" class="selected">Sand</button>
    <button data-mat="2">Water</button>
    <button data-mat="3">Stone</button>
    <button data-mat="4">Plant</button>
    <button data-mat="5">Fire</button>
    <button data-mat="0">Erase</button>
    <button id="clear" class="right">Clear</button>
  </div>
  <canvas id="scene"></canvas>
  <p class="hint">Pick a material and draw on the canvas. Keys 1–6 switch materials.</p>
</Lab>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }
  .toolbar button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--soft);
    color: var(--fg);
    cursor: pointer;
  }
  .toolbar button:hover {
    border-color: var(--accent);
  }
  .toolbar button.selected {
    border-color: var(--accent);
    color: var(--accent);
  }
  .toolbar .right {
    margin-left: auto;
  }
  canvas {
    width: 100%;
    height: 460px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--soft);
    image-rendering: pixelated;
    touch-action: none;
    cursor: crosshair;
  }
  .hint {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }
</style>

<script>
  const canvas = document.getElementById('scene') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const CELL = 4; // CSS pixels per grid cell

  const EMPTY = 0, SAND = 1, WATER = 2, STONE = 3, PLANT = 4, FIRE = 5, SMOKE = 6;

  let cols = 0, rows = 0;
  let grid: Uint8Array, shade: Uint8Array, life: Uint8Array, moved: Uint8Array;
  let img: ImageData;
  let frame = 0;

  function resize() {
    const ncols = Math.max(20, Math.floor(canvas.clientWidth / CELL));
    const nrows = Math.max(20, Math.floor(canvas.clientHeight / CELL));
    if (ncols === cols && nrows === rows) return;
    const ngrid = new Uint8Array(ncols * nrows);
    const nshade = new Uint8Array(ncols * nrows);
    const nlife = new Uint8Array(ncols * nrows);
    if (grid) {
      // Preserve the overlapping region instead of wiping the world.
      for (let y = 0; y < Math.min(rows, nrows); y++) {
        for (let x = 0; x < Math.min(cols, ncols); x++) {
          ngrid[y * ncols + x] = grid[y * cols + x];
          nshade[y * ncols + x] = shade[y * cols + x];
          nlife[y * ncols + x] = life[y * cols + x];
        }
      }
    }
    const first = !grid;
    cols = ncols;
    rows = nrows;
    canvas.width = cols;
    canvas.height = rows;
    grid = ngrid;
    shade = nshade;
    life = nlife;
    moved = new Uint8Array(cols * rows);
    img = ctx.createImageData(cols, rows);
    if (first) seed();
  }

  function set(i: number, mat: number) {
    grid[i] = mat;
    shade[i] = (Math.random() * 256) | 0;
    if (mat === FIRE) life[i] = 40 + ((Math.random() * 40) | 0);
    else if (mat === SMOKE) life[i] = 60 + ((Math.random() * 80) | 0);
    else life[i] = 0;
  }

  function seed() {
    // Two stone ledges and a small plant patch to invite play.
    const ledge = (y: number, x0: number, x1: number) => {
      for (let x = x0; x <= x1; x++) set(y * cols + x, STONE);
    };
    const y1 = (rows * 0.62) | 0, y2 = (rows * 0.4) | 0;
    ledge(y1, (cols * 0.08) | 0, (cols * 0.42) | 0);
    ledge(y2, (cols * 0.55) | 0, (cols * 0.9) | 0);
    for (let x = (cols * 0.16) | 0; x <= (cols * 0.3) | 0; x++) {
      if (Math.random() < 0.8) set((y1 - 1) * cols + x, PLANT);
    }
  }

  // --- simulation ---

  function swap(a: number, b: number) {
    const gm = grid[a], gs = shade[a], gl = life[a];
    grid[a] = grid[b]; shade[a] = shade[b]; life[a] = life[b];
    grid[b] = gm; shade[b] = gs; life[b] = gl;
    moved[a] = moved[b] = 1;
  }

  function step() {
    moved.fill(0);
    const ltr = (frame & 1) === 0;
    for (let y = rows - 1; y >= 0; y--) {
      for (let i = 0; i < cols; i++) {
        const x = ltr ? i : cols - 1 - i;
        const idx = y * cols + x;
        if (moved[idx]) continue;
        const m = grid[idx];
        if (m === EMPTY || m === STONE) continue;
        if (m === SAND) stepSand(x, y, idx);
        else if (m === WATER) stepWater(x, y, idx);
        else if (m === PLANT) stepPlant(x, y, idx);
        else if (m === FIRE) stepFire(x, y, idx);
        else if (m === SMOKE) stepSmoke(x, y, idx);
      }
    }
  }

  function stepSand(x: number, y: number, idx: number) {
    if (y + 1 >= rows) return;
    const below = idx + cols;
    const passable = (m: number) => m === EMPTY || m === WATER || m === SMOKE;
    if (passable(grid[below])) return swap(idx, below);
    const d = Math.random() < 0.5 ? -1 : 1;
    for (const dx of [d, -d]) {
      const nx = x + dx;
      if (nx >= 0 && nx < cols && passable(grid[below + dx])) return swap(idx, below + dx);
    }
  }

  function stepWater(x: number, y: number, idx: number) {
    const passable = (m: number) => m === EMPTY || m === SMOKE;
    if (y + 1 < rows) {
      const below = idx + cols;
      if (passable(grid[below])) return swap(idx, below);
      const d = Math.random() < 0.5 ? -1 : 1;
      for (const dx of [d, -d]) {
        const nx = x + dx;
        if (nx >= 0 && nx < cols && passable(grid[below + dx])) return swap(idx, below + dx);
      }
    }
    const d = Math.random() < 0.5 ? -1 : 1;
    for (const dx of [d, -d]) {
      const nx = x + dx;
      if (nx >= 0 && nx < cols && grid[idx + dx] === EMPTY) return swap(idx, idx + dx);
    }
  }

  function stepPlant(x: number, y: number, idx: number) {
    // Slowly absorb adjacent water and grow into it.
    if (Math.random() > 0.03) return;
    const dirs = [-cols, cols, -1, 1];
    for (const d of dirs) {
      const n = idx + d;
      const nx = x + (d === -1 ? -1 : d === 1 ? 1 : 0);
      if (nx < 0 || nx >= cols || n < 0 || n >= grid.length) continue;
      if (grid[n] === WATER && Math.random() < 0.5) {
        set(n, PLANT);
        return;
      }
    }
  }

  function stepFire(x: number, y: number, idx: number) {
    if (--life[idx] === 0) {
      set(idx, Math.random() < 0.6 ? SMOKE : EMPTY);
      return;
    }
    const dirs = [-cols, cols, -1, 1];
    for (const d of dirs) {
      const n = idx + d;
      const nx = x + (d === -1 ? -1 : d === 1 ? 1 : 0);
      if (nx < 0 || nx >= cols || n < 0 || n >= grid.length) continue;
      if (grid[n] === PLANT && Math.random() < 0.25) set(n, FIRE);
      else if (grid[n] === WATER && Math.random() < 0.5) {
        set(idx, SMOKE); // doused into steam
        return;
      }
    }
    // Flicker upward.
    if (y > 0 && Math.random() < 0.35) {
      const up = idx - cols;
      if (grid[up] === EMPTY) swap(idx, up);
    }
  }

  function stepSmoke(x: number, y: number, idx: number) {
    if (--life[idx] === 0) return set(idx, EMPTY);
    if (Math.random() < 0.7) {
      const d = Math.random() < 0.5 ? -1 : 1;
      const tries = y > 0 ? [-cols, -cols + d, d] : [d];
      for (const t of tries) {
        const n = idx + t;
        const nx = x + (t === d || t === -cols + d ? d : 0);
        if (nx < 0 || nx >= cols || n < 0) continue;
        if (grid[n] === EMPTY) return swap(idx, n);
      }
    }
  }

  // --- rendering ---

  function draw() {
    const data = img.data;
    for (let i = 0; i < grid.length; i++) {
      const m = grid[i];
      const o = i * 4;
      if (m === EMPTY) {
        data[o + 3] = 0;
        continue;
      }
      const v = (shade[i] & 31) - 16;
      let r = 0, g = 0, b = 0, a = 255;
      if (m === SAND) { r = 212 + v; g = 178 + v; b = 102 + v; }
      else if (m === WATER) { r = 56; g = 130 + v; b = 214 + (v >> 1); a = 230; }
      else if (m === STONE) { r = 130 + (v >> 1); g = 134 + (v >> 1); b = 140 + (v >> 1); }
      else if (m === PLANT) { r = 66 + v; g = 152 + v; b = 80 + v; }
      else if (m === FIRE) {
        const f = life[i] / 80;
        r = 200 + 55 * f; g = 60 + 170 * f; b = 20 + 60 * f;
      } else if (m === SMOKE) {
        r = g = b = 128 + v;
        a = Math.min(180, life[i] * 3);
      }
      data[o] = r; data[o + 1] = g; data[o + 2] = b; data[o + 3] = a;
    }
    ctx.putImageData(img, 0, 0);
  }

  // --- input ---

  let material = SAND;
  let painting = false;
  let last: { x: number; y: number } | null = null;

  const toolbar = document.getElementById('toolbar')!;
  const matButtons = Array.from(toolbar.querySelectorAll<HTMLButtonElement>('button[data-mat]'));

  function selectMaterial(mat: number) {
    material = mat;
    for (const b of matButtons) b.classList.toggle('selected', Number(b.dataset.mat) === mat);
  }

  toolbar.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    if (btn.id === 'clear') {
      grid.fill(EMPTY);
      seed();
    } else if (btn.dataset.mat != null) {
      selectMaterial(Number(btn.dataset.mat));
    }
  });

  window.addEventListener('keydown', (e) => {
    const order = [SAND, WATER, STONE, PLANT, FIRE, EMPTY];
    const n = Number(e.key);
    if (n >= 1 && n <= order.length) selectMaterial(order[n - 1]);
  });

  function stamp(gx: number, gy: number) {
    const R = material === EMPTY ? 5 : 3;
    const solid = material === STONE || material === PLANT || material === EMPTY;
    for (let dy = -R; dy <= R; dy++) {
      for (let dx = -R; dx <= R; dx++) {
        if (dx * dx + dy * dy > R * R) continue;
        const x = gx + dx, y = gy + dy;
        if (x < 0 || x >= cols || y < 0 || y >= rows) continue;
        if (!solid && Math.random() > 0.7) continue;
        const i = y * cols + x;
        if (material !== EMPTY && grid[i] === STONE) continue;
        set(i, material);
      }
    }
  }

  function paintAt(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect();
    const gx = ((e.clientX - rect.left) / CELL) | 0;
    const gy = ((e.clientY - rect.top) / CELL) | 0;
    if (last) {
      const steps = Math.max(Math.abs(gx - last.x), Math.abs(gy - last.y));
      for (let s = 1; s <= steps; s++) {
        stamp(last.x + ((gx - last.x) * s) / steps | 0, last.y + ((gy - last.y) * s) / steps | 0);
      }
    } else {
      stamp(gx, gy);
    }
    last = { x: gx, y: gy };
  }

  canvas.addEventListener('pointerdown', (e) => {
    painting = true;
    last = null;
    canvas.setPointerCapture(e.pointerId);
    paintAt(e);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (painting) paintAt(e);
  });
  canvas.addEventListener('pointerup', () => {
    painting = false;
    last = null;
  });

  // --- loop ---

  function tick() {
    frame++;
    // Opening pour of sand so the page moves before any input.
    if (frame < 140 && frame % 2 === 0) {
      const cx = (cols / 2) | 0;
      const i = 2 * cols + cx + ((Math.random() * 5) | 0) - 2;
      if (grid[i] === EMPTY) set(i, SAND);
    }
    step();
    step();
    draw();
    requestAnimationFrame(tick);
  }

  window.addEventListener('resize', resize);
  resize();
  requestAnimationFrame(tick);
</script>
