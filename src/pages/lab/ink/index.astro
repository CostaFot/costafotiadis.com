---
import Lab from '../../../layouts/Lab.astro';

export const experiment = {
  title: 'Ink',
  description: 'Swirl colored ink through water with your cursor. Stable fluids, per Jos Stam.',
  date: '2026-08-21',
};
---

<Lab {...experiment}>
  <canvas id="scene"></canvas>
</Lab>

<style>
  canvas {
    display: block;
    width: 100%;
    height: 420px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--soft);
    touch-action: none;
    cursor: crosshair;
  }
</style>

<script>
  const canvas = document.getElementById('scene') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const off = document.createElement('canvas');
  const offCtx = off.getContext('2d')!;

  const DT = 1 / 60;
  const PRESSURE_ITERS = 20;
  const DYE_FADE = 0.996;
  const VORTICITY = 12;

  let NX = 0;
  let NY = 0;
  let u: Float32Array, v: Float32Array, u0: Float32Array, v0: Float32Array;
  let dyeR: Float32Array, dyeG: Float32Array, dyeB: Float32Array, dye0: Float32Array;
  let p: Float32Array, div: Float32Array, curl: Float32Array;
  let img: ImageData;

  const IX = (i: number, j: number) => i + (NX + 2) * j;

  function init() {
    canvas.width = canvas.clientWidth;
    canvas.height = canvas.clientHeight;
    NX = 176;
    NY = Math.max(48, Math.min(176, Math.round((NX * canvas.height) / canvas.width)));
    const size = (NX + 2) * (NY + 2);
    u = new Float32Array(size);
    v = new Float32Array(size);
    u0 = new Float32Array(size);
    v0 = new Float32Array(size);
    dyeR = new Float32Array(size);
    dyeG = new Float32Array(size);
    dyeB = new Float32Array(size);
    dye0 = new Float32Array(size);
    p = new Float32Array(size);
    div = new Float32Array(size);
    curl = new Float32Array(size);
    off.width = NX;
    off.height = NY;
    img = offCtx.createImageData(NX, NY);
    for (let i = 0; i < 4; i++) randomSplat();
  }

  function setBnd(b: number, x: Float32Array) {
    for (let i = 1; i <= NX; i++) {
      x[IX(i, 0)] = b === 2 ? -x[IX(i, 1)] : x[IX(i, 1)];
      x[IX(i, NY + 1)] = b === 2 ? -x[IX(i, NY)] : x[IX(i, NY)];
    }
    for (let j = 1; j <= NY; j++) {
      x[IX(0, j)] = b === 1 ? -x[IX(1, j)] : x[IX(1, j)];
      x[IX(NX + 1, j)] = b === 1 ? -x[IX(NX, j)] : x[IX(NX, j)];
    }
    x[IX(0, 0)] = 0.5 * (x[IX(1, 0)] + x[IX(0, 1)]);
    x[IX(0, NY + 1)] = 0.5 * (x[IX(1, NY + 1)] + x[IX(0, NY)]);
    x[IX(NX + 1, 0)] = 0.5 * (x[IX(NX, 0)] + x[IX(NX + 1, 1)]);
    x[IX(NX + 1, NY + 1)] = 0.5 * (x[IX(NX, NY + 1)] + x[IX(NX + 1, NY)]);
  }

  function advect(
    b: number,
    d: Float32Array,
    d0: Float32Array,
    uu: Float32Array,
    vv: Float32Array,
    fade: number,
  ) {
    for (let j = 1; j <= NY; j++) {
      for (let i = 1; i <= NX; i++) {
        let x = i - DT * uu[IX(i, j)];
        let y = j - DT * vv[IX(i, j)];
        x = Math.max(0.5, Math.min(NX + 0.5, x));
        y = Math.max(0.5, Math.min(NY + 0.5, y));
        const i0 = Math.floor(x);
        const j0 = Math.floor(y);
        const s1 = x - i0;
        const t1 = y - j0;
        const s0 = 1 - s1;
        const t0 = 1 - t1;
        d[IX(i, j)] =
          fade *
          (s0 * (t0 * d0[IX(i0, j0)] + t1 * d0[IX(i0, j0 + 1)]) +
            s1 * (t0 * d0[IX(i0 + 1, j0)] + t1 * d0[IX(i0 + 1, j0 + 1)]));
      }
    }
    setBnd(b, d);
  }

  function project() {
    for (let j = 1; j <= NY; j++) {
      for (let i = 1; i <= NX; i++) {
        div[IX(i, j)] =
          -0.5 * (u[IX(i + 1, j)] - u[IX(i - 1, j)] + v[IX(i, j + 1)] - v[IX(i, j - 1)]);
        p[IX(i, j)] = 0;
      }
    }
    setBnd(0, div);
    setBnd(0, p);
    for (let k = 0; k < PRESSURE_ITERS; k++) {
      for (let j = 1; j <= NY; j++) {
        for (let i = 1; i <= NX; i++) {
          p[IX(i, j)] =
            (div[IX(i, j)] + p[IX(i - 1, j)] + p[IX(i + 1, j)] + p[IX(i, j - 1)] + p[IX(i, j + 1)]) /
            4;
        }
      }
      setBnd(0, p);
    }
    for (let j = 1; j <= NY; j++) {
      for (let i = 1; i <= NX; i++) {
        u[IX(i, j)] -= 0.5 * (p[IX(i + 1, j)] - p[IX(i - 1, j)]);
        v[IX(i, j)] -= 0.5 * (p[IX(i, j + 1)] - p[IX(i, j - 1)]);
      }
    }
    setBnd(1, u);
    setBnd(2, v);
  }

  // Vorticity confinement: reinject the small swirls the coarse grid smears away.
  function vorticity() {
    for (let j = 1; j <= NY; j++) {
      for (let i = 1; i <= NX; i++) {
        curl[IX(i, j)] =
          0.5 * (v[IX(i + 1, j)] - v[IX(i - 1, j)] - (u[IX(i, j + 1)] - u[IX(i, j - 1)]));
      }
    }
    for (let j = 2; j < NY; j++) {
      for (let i = 2; i < NX; i++) {
        const dwdx = 0.5 * (Math.abs(curl[IX(i + 1, j)]) - Math.abs(curl[IX(i - 1, j)]));
        const dwdy = 0.5 * (Math.abs(curl[IX(i, j + 1)]) - Math.abs(curl[IX(i, j - 1)]));
        const len = Math.hypot(dwdx, dwdy) + 1e-5;
        const w = curl[IX(i, j)];
        u[IX(i, j)] += DT * VORTICITY * (dwdy / len) * w;
        v[IX(i, j)] -= DT * VORTICITY * (dwdx / len) * w;
      }
    }
  }

  function step() {
    vorticity();
    project();
    u0.set(u);
    v0.set(v);
    advect(1, u, u0, u0, v0, 1);
    advect(2, v, v0, u0, v0, 1);
    project();
    for (const d of [dyeR, dyeG, dyeB]) {
      dye0.set(d);
      advect(0, d, dye0, u, v, DYE_FADE);
    }
  }

  function splat(gx: number, gy: number, dx: number, dy: number, cr: number, cg: number, cb: number) {
    const rad = 4;
    const i0 = Math.max(1, Math.floor(gx - rad * 2));
    const i1 = Math.min(NX, Math.ceil(gx + rad * 2));
    const j0 = Math.max(1, Math.floor(gy - rad * 2));
    const j1 = Math.min(NY, Math.ceil(gy + rad * 2));
    for (let j = j0; j <= j1; j++) {
      for (let i = i0; i <= i1; i++) {
        const dsq = (i - gx) * (i - gx) + (j - gy) * (j - gy);
        const fall = Math.exp(-dsq / (rad * rad * 0.5));
        const s = IX(i, j);
        u[s] += dx * fall;
        v[s] += dy * fall;
        dyeR[s] = Math.min(340, dyeR[s] + cr * fall);
        dyeG[s] = Math.min(340, dyeG[s] + cg * fall);
        dyeB[s] = Math.min(340, dyeB[s] + cb * fall);
      }
    }
  }

  function hsl2rgb(h: number, s: number, l: number) {
    const f = (n: number) => {
      const k = (n + h / 30) % 12;
      return l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
    };
    return [f(0) * 255, f(8) * 255, f(4) * 255];
  }

  let hue = Math.random() * 360;
  let lastInteraction = 0;

  function randomSplat() {
    const angle = Math.random() * Math.PI * 2;
    const speed = 150 + Math.random() * 250;
    const [cr, cg, cb] = hsl2rgb(Math.random() * 360, 0.9, 0.6);
    splat(
      2 + Math.random() * (NX - 4),
      2 + Math.random() * (NY - 4),
      Math.cos(angle) * speed,
      Math.sin(angle) * speed,
      cr * 0.9,
      cg * 0.9,
      cb * 0.9,
    );
  }

  let baseColor = [255, 255, 255];
  let darkMode = false;
  function readTheme() {
    const card = getComputedStyle(canvas).backgroundColor;
    const m = card.match(/\d+/g);
    if (m) baseColor = [+m[0], +m[1], +m[2]];
    darkMode = baseColor[0] + baseColor[1] + baseColor[2] < 384;
  }

  function render() {
    const data = img.data;
    const [br, bg, bb] = baseColor;
    for (let j = 1; j <= NY; j++) {
      for (let i = 1; i <= NX; i++) {
        const s = IX(i, j);
        const d = ((j - 1) * NX + (i - 1)) * 4;
        if (darkMode) {
          data[d] = Math.min(255, br + dyeR[s] * 1.8);
          data[d + 1] = Math.min(255, bg + dyeG[s] * 1.8);
          data[d + 2] = Math.min(255, bb + dyeB[s] * 1.8);
        } else {
          data[d] = Math.max(0, br - dyeR[s] * 1.3);
          data[d + 1] = Math.max(0, bg - dyeG[s] * 1.3);
          data[d + 2] = Math.max(0, bb - dyeB[s] * 1.3);
        }
        data[d + 3] = 255;
      }
    }
    offCtx.putImageData(img, 0, 0);
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(off, 0, 0, canvas.width, canvas.height);
  }

  let prev: { x: number; y: number } | null = null;

  canvas.addEventListener('pointermove', (e) => {
    const rect = canvas.getBoundingClientRect();
    const gx = ((e.clientX - rect.left) / rect.width) * NX;
    const gy = ((e.clientY - rect.top) / rect.height) * NY;
    if (prev) {
      const dx = gx - prev.x;
      const dy = gy - prev.y;
      const dist = Math.hypot(dx, dy);
      if (dist > 0.3) {
        const dvx = Math.max(-400, Math.min(400, dx * 40));
        const dvy = Math.max(-400, Math.min(400, dy * 40));
        hue = (hue + dist * 0.6) % 360;
        // Dye scales with distance moved, so total ink tracks path length
        // no matter how often the browser fires pointer events.
        const amt = Math.min(1, dist * 0.12);
        const [cr, cg, cb] = hsl2rgb(hue, 0.95, 0.55);
        splat(gx, gy, dvx, dvy, cr * amt, cg * amt, cb * amt);
        lastInteraction = performance.now();
      }
    }
    prev = { x: gx, y: gy };
  });
  canvas.addEventListener('pointerleave', () => (prev = null));

  setInterval(() => {
    if (performance.now() - lastInteraction > 4000) randomSplat();
  }, 2500);

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      init();
      readTheme();
    }, 150);
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readTheme);

  function tick() {
    step();
    render();
    requestAnimationFrame(tick);
  }

  init();
  readTheme();
  tick();
</script>
