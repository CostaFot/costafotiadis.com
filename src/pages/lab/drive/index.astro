---
import Lab from '../../../layouts/Lab.astro';

export const experiment = {
  title: 'Infinite Drive',
  description: 'Endless synthwave road trip. Arrow keys or A/D to steer.',
  date: '2026-08-21',
};
---

<Lab {...experiment} note="On touch, hold either half of the screen.">
  <div class="stage">
    <canvas id="scene"></canvas>
    <div class="hud"><span id="odo">0.0 km</span></div>
  </div>
</Lab>

<style>
  .stage {
    position: relative;
  }
  canvas {
    display: block;
    width: 100%;
    height: 480px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #16062b;
    touch-action: none;
  }
  .hud {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    color: #ffd319;
    font-family: var(--mono);
    font-size: 0.9rem;
    text-shadow: 0 0 8px rgba(255, 41, 117, 0.8);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('scene') as HTMLCanvasElement;
  const odo = document.getElementById('odo') as HTMLSpanElement;

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  const SKY = '#16062b';
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(SKY);
  scene.fog = new THREE.Fog(SKY, 60, 320);

  const camera = new THREE.PerspectiveCamera(70, 1, 0.1, 500);
  camera.position.set(0, 4.5, 11);
  camera.lookAt(0, 1.5, -30);

  scene.add(new THREE.HemisphereLight('#8a4fff', '#1a0b2e', 1.4));
  const sunLight = new THREE.DirectionalLight('#ff9a5c', 1.6);
  sunLight.position.set(-6, 10, -20);
  scene.add(sunLight);

  // --- Sun: striped synthwave disc on a canvas texture ---
  function sunTexture() {
    const c = document.createElement('canvas');
    c.width = c.height = 256;
    const g = c.getContext('2d')!;
    const grad = g.createLinearGradient(0, 0, 0, 256);
    grad.addColorStop(0, '#ffd319');
    grad.addColorStop(1, '#ff2975');
    g.fillStyle = grad;
    g.fillRect(0, 0, 256, 256);
    g.globalCompositeOperation = 'destination-out';
    for (let y = 150; y < 256; y += 24) {
      g.fillRect(0, y, 256, 4 + (y - 150) / 12);
    }
    return new THREE.CanvasTexture(c);
  }
  const sunMat = new THREE.MeshBasicMaterial({ map: sunTexture(), transparent: true });
  sunMat.fog = false;
  const sun = new THREE.Mesh(new THREE.CircleGeometry(45, 48), sunMat);
  sun.position.set(0, 26, -310);
  scene.add(sun);

  // --- Stars ---
  const starPos = new Float32Array(300 * 3);
  for (let i = 0; i < 300; i++) {
    starPos[i * 3] = (Math.random() - 0.5) * 600;
    starPos[i * 3 + 1] = 40 + Math.random() * 160;
    starPos[i * 3 + 2] = -280 - Math.random() * 100;
  }
  const starGeo = new THREE.BufferGeometry();
  starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
  const starMat = new THREE.PointsMaterial({ color: '#ffffff', size: 1.2, transparent: true, opacity: 0.7 });
  starMat.fog = false;
  scene.add(new THREE.Points(starGeo, starMat));

  // --- Road ---
  const ROAD_W = 14;
  const road = new THREE.Mesh(
    new THREE.PlaneGeometry(ROAD_W, 500),
    new THREE.MeshStandardMaterial({ color: '#181226' })
  );
  road.rotation.x = -Math.PI / 2;
  road.position.z = -200;
  scene.add(road);

  const ground = new THREE.Mesh(
    new THREE.PlaneGeometry(600, 500),
    new THREE.MeshStandardMaterial({ color: '#0e0620' })
  );
  ground.rotation.x = -Math.PI / 2;
  ground.position.set(0, -0.05, -200);
  scene.add(ground);

  for (const side of [-1, 1]) {
    const edge = new THREE.Mesh(
      new THREE.BoxGeometry(0.3, 0.02, 500),
      new THREE.MeshBasicMaterial({ color: '#ff2975' })
    );
    edge.position.set(side * (ROAD_W / 2), 0.01, -200);
    scene.add(edge);
  }

  // --- Recycled scenery: anything past the camera loops back to the horizon ---
  type Scrolling = { obj: THREE.Object3D; span: number };
  const scrolling: Scrolling[] = [];

  const stripeMat = new THREE.MeshBasicMaterial({ color: '#ffd319' });
  for (let z = 20; z > -400; z -= 14) {
    const stripe = new THREE.Mesh(new THREE.BoxGeometry(0.35, 0.02, 5), stripeMat);
    stripe.position.set(0, 0.02, z);
    scene.add(stripe);
    scrolling.push({ obj: stripe, span: 420 });
  }

  const pylonMat = new THREE.MeshStandardMaterial({
    color: '#2d1b4e',
    emissive: '#ff2975',
    emissiveIntensity: 0.6,
  });
  for (let z = 0; z > -400; z -= 40) {
    for (const side of [-1, 1]) {
      const pylon = new THREE.Mesh(new THREE.BoxGeometry(0.5, 6, 0.5), pylonMat);
      pylon.position.set(side * (ROAD_W / 2 + 2.5), 3, z - (side > 0 ? 20 : 0));
      scene.add(pylon);
      scrolling.push({ obj: pylon, span: 400 });
    }
  }

  const mountainMat = new THREE.MeshStandardMaterial({ color: '#241245', flatShading: true });
  for (let z = -20; z > -620; z -= 30) {
    for (const side of [-1, 1]) {
      const h = 12 + Math.random() * 30;
      const mountain = new THREE.Mesh(new THREE.ConeGeometry(8 + Math.random() * 14, h, 4 + Math.floor(Math.random() * 3)), mountainMat);
      mountain.position.set(side * (30 + Math.random() * 60), h / 2 - 0.1, z - Math.random() * 20);
      mountain.rotation.y = Math.random() * Math.PI;
      scene.add(mountain);
      scrolling.push({ obj: mountain, span: 600 });
    }
  }

  // --- Car ---
  const car = new THREE.Group();
  const body = new THREE.Mesh(
    new THREE.BoxGeometry(2, 0.6, 4),
    new THREE.MeshStandardMaterial({ color: '#ff4757', flatShading: true })
  );
  body.position.y = 0.65;
  car.add(body);
  const cabin = new THREE.Mesh(
    new THREE.BoxGeometry(1.5, 0.55, 1.9),
    new THREE.MeshStandardMaterial({ color: '#1a1a2e', flatShading: true })
  );
  cabin.position.set(0, 1.2, 0.3);
  car.add(cabin);
  const wheelGeo = new THREE.CylinderGeometry(0.4, 0.4, 0.35, 12);
  const wheelMat = new THREE.MeshStandardMaterial({ color: '#111118' });
  for (const [wx, wz] of [[-0.95, -1.3], [0.95, -1.3], [-0.95, 1.3], [0.95, 1.3]]) {
    const wheel = new THREE.Mesh(wheelGeo, wheelMat);
    wheel.rotation.z = Math.PI / 2;
    wheel.position.set(wx, 0.4, wz);
    car.add(wheel);
  }
  car.position.z = 2;
  scene.add(car);

  // --- Controls ---
  let input = 0;
  const keys = new Set<string>();
  function readKeys() {
    const left = keys.has('ArrowLeft') || keys.has('a');
    const right = keys.has('ArrowRight') || keys.has('d');
    input = (right ? 1 : 0) - (left ? 1 : 0);
  }
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') e.preventDefault();
    keys.add(e.key.length === 1 ? e.key.toLowerCase() : e.key);
    readKeys();
  });
  window.addEventListener('keyup', (e) => {
    keys.delete(e.key.length === 1 ? e.key.toLowerCase() : e.key);
    readKeys();
  });
  canvas.addEventListener('pointerdown', (e) => {
    const rect = canvas.getBoundingClientRect();
    input = e.clientX - rect.left < rect.width / 2 ? -1 : 1;
  });
  for (const ev of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
    canvas.addEventListener(ev, () => {
      input = 0;
      readKeys();
    });
  }

  // --- Loop ---
  const MAX_X = ROAD_W / 2 - 1.6;
  let speed = 55; // units per second
  let distance = 0;
  let carX = 0;
  let roll = 0;
  const clock = new THREE.Clock();

  function resize() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (canvas.width !== Math.round(w * renderer.getPixelRatio())) {
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
  }

  function tick() {
    const dt = Math.min(clock.getDelta(), 0.05);
    resize();

    speed = Math.min(speed + dt * 1.5, 130);
    distance += speed * dt;
    odo.textContent = `${(distance / 250).toFixed(1)} km`;

    for (const { obj, span } of scrolling) {
      obj.position.z += speed * dt;
      if (obj.position.z > 25) obj.position.z -= span;
    }

    carX = THREE.MathUtils.clamp(carX + input * 14 * dt, -MAX_X, MAX_X);
    car.position.x = THREE.MathUtils.lerp(car.position.x, carX, 1 - Math.pow(0.001, dt));
    roll = THREE.MathUtils.lerp(roll, -input * 0.12, 1 - Math.pow(0.005, dt));
    car.rotation.z = roll;
    car.rotation.y = roll * 0.6;
    camera.position.x = car.position.x * 0.5;

    renderer.render(scene, camera);
    requestAnimationFrame(tick);
  }

  window.addEventListener('resize', resize);
  resize();
  tick();
</script>
