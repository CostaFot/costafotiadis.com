---
// Install numbers for the Command Palette extensions. The shell (names, links,
// notes) is static; a script fills the numbers and draws the charts from the
// CSVs that CostaFot/stats records daily onto its orphan `data` branch.
import Base from '../layouts/Base.astro';
import apps from '../data/stats-apps.json';
---
<Base title="Stats" description="Install numbers for the Command Palette extensions, updated daily">
  <header class="post-head">
    <p class="eyebrow">Command Palette extensions</p>
    <h1>Stats</h1>
    <p class="meta"><span id="updated">GitHub, WinGet and Microsoft Store, recorded daily</span></p>
  </header>

  <div class="stats">
    <p id="status" class="status">Loading stats…<noscript> Actually, the numbers need JavaScript; the links below work without it.</noscript></p>

    <section class="tiles" id="tiles" aria-label="Totals" hidden>
      {['Total installs', 'GitHub + WinGet', 'Microsoft Store', 'Last 7 days'].map((label) => (
        <div class="card tile">
          <div class="label">{label}</div>
          <div class="value">–</div>
          <div class="note"></div>
        </div>
      ))}
    </section>

    <section class="apps" aria-label="Per-app stats">
      {apps.map((a, i) => (
        <div class="card app" data-slug={a.slug} data-series={`--series-${(i % 4) + 1}`}>
          <div class="name-row">
            <span class="dot" style={`background: var(--series-${(i % 4) + 1})`}></span>
            <span class="name">{a.name}</span>
            <span class="links">
              <a href={`https://github.com/${a.repo}`} title="GitHub repo">GitHub</a>
              <a href={`https://apps.microsoft.com/detail/${a.storeId}`} title="Microsoft Store listing">Store</a>
            </span>
          </div>
          <div class="value" hidden></div>
          <p class="breakdown" hidden></p>
          <div class="spark" hidden><canvas id={`spark-${i}`}></canvas></div>
        </div>
      ))}
    </section>

    <section class="card chart-card" id="chart-card" hidden>
      <h2>Cumulative installs over time</h2>
      <p class="hint">GitHub + WinGet downloads plus Store acquisitions, per app</p>
      <div class="chart-box"><canvas id="chart"></canvas></div>
    </section>

    <p class="fine">
      Recorded daily by <a href="https://github.com/CostaFot/stats/actions/workflows/record-stats.yml">GitHub Actions</a>
      onto the <a href="https://github.com/CostaFot/stats/tree/data/data"><code>data</code> branch</a> of the stats repo.
      GitHub counts direct and WinGet release downloads; the Store counts acquisitions and lags a day or two.
    </p>
  </div>
</Base>

<style>
  .stats {
    margin-left: var(--rail);
    /* Series colours are local to this page; the shared tokens stay in global.css. */
    --series-1: var(--accent);
    --series-2: #2a78d6;
    --series-3: #1baf7a;
    --series-4: #9b5de5;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .stats { --series-2: #4a90e8; --series-3: #2cc48f; --series-4: #b07cf0; }
  }
  :root[data-theme="dark"] .stats { --series-2: #4a90e8; --series-3: #2cc48f; --series-4: #b07cf0; }

  .status { color: var(--muted); font-family: var(--mono); font-size: 0.8rem; margin: 0 0 1.5rem; }
  .card { border: 1px solid var(--border); border-radius: 6px; padding: 0.9rem 1rem; min-width: 0; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: 0.75rem; margin: 0 0 0.75rem; }
  .tile .label { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .tile .value { font-family: var(--display); font-weight: 800; font-size: 1.9rem; letter-spacing: -0.03em; line-height: 1.1; margin-top: 0.25rem; }
  .tile .note { color: var(--muted); font-size: 0.8rem; margin-top: 0.15rem; min-height: 1.2em; }
  .tile .value.delta-up { color: var(--accent); }

  .apps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin: 0 0 0.75rem; }
  .app .name-row { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.92rem; }
  .app .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: none; }
  .app .links { margin-left: auto; display: flex; gap: 0.35rem; }
  .app .links a {
    display: inline-block; padding: 0.2rem 0.45rem; border-radius: 6px;
    font: 500 0.68rem/1 var(--mono); color: var(--muted);
    border: 1px solid var(--border); text-decoration: none;
  }
  .app .links a:hover { background: var(--soft); border-color: var(--accent); color: var(--fg); }
  .app .value { font-family: var(--display); font-weight: 800; font-size: 1.6rem; letter-spacing: -0.03em; line-height: 1.1; margin-top: 0.6rem; }
  .app .value.empty { color: var(--muted); font-weight: 600; font-size: 1.1rem; }
  .app .breakdown { color: var(--muted); font-size: 0.82rem; margin: 0.1rem 0 0.5rem; }
  .app .spark { position: relative; height: 44px; }

  .chart-card { margin-bottom: 1.25rem; }
  .chart-card h2 { font-family: var(--display); font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em; margin: 0 0 0.15rem; }
  .chart-card .hint { color: var(--muted); font-size: 0.82rem; margin: 0 0 0.6rem; }
  .chart-box { position: relative; height: 320px; }

  .fine { color: var(--muted); font-size: 0.85rem; margin: 0; max-width: 38rem; }
  .fine a { text-decoration-color: var(--accent); }
  .fine code { font-family: var(--mono); font-size: 0.85em; background: var(--soft); border: 1px solid var(--border); border-radius: 4px; padding: 0.1em 0.35em; }

  @media (max-width: 40rem) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .apps { grid-template-columns: 1fr; }
    .chart-box { height: 240px; }
  }
</style>

<script>
  import { Chart, LineController, LineElement, PointElement, LinearScale, CategoryScale, Legend, Tooltip } from 'chart.js';

  Chart.register(LineController, LineElement, PointElement, LinearScale, CategoryScale, Legend, Tooltip);

  // refs/heads/ keeps the ref unambiguous: the short form makes
  // raw.githubusercontent.com guess where the ref ends, and it 400s on some paths.
  const DATA_BASE = 'https://raw.githubusercontent.com/CostaFot/stats/refs/heads/data/data/';

  type Row = { date: string; github: number | null; store: number | null };
  type App = { el: HTMLElement; slug: string; name: string; seriesVar: string; rows: Row[] | null };

  const fmt = (n: number | null | undefined) => (n == null ? '–' : Math.round(n).toLocaleString('en-US'));
  const cssVar = (name: string, el: Element = document.documentElement) => getComputedStyle(el).getPropertyValue(name).trim();
  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector(sel) as T;

  const root = $('.stats');
  let apps: App[] = [];
  let charts: Chart[] = [];

  function parseCsv(text: string): Row[] {
    const lines = text.trim().split(/\r?\n/);
    lines.shift(); // header: date,github_downloads,store_acquisitions
    return lines
      .filter((l) => l.trim() !== '')
      .map((line) => {
        const [date, gh, store] = line.split(',');
        return {
          date,
          github: gh === undefined || gh === '' ? null : Number(gh),
          store: store === undefined || store === '' ? null : Number(store),
        };
      })
      .sort((a, b) => a.date.localeCompare(b.date));
  }

  // Cumulative series: a blank cell means "not recorded that day", not zero;
  // carry the last known value forward.
  function forwardFill(values: (number | null)[]) {
    let last: number | null = null;
    return values.map((v) => (v == null ? last : (last = v)));
  }

  function lastKnown(rows: Row[], key: 'github' | 'store') {
    for (let i = rows.length - 1; i >= 0; i--) if (rows[i][key] != null) return rows[i][key];
    return null;
  }

  // Per-app combined cumulative series over that app's own dates.
  function combinedSeries(rows: Row[]) {
    const gh = forwardFill(rows.map((r) => r.github));
    const st = forwardFill(rows.map((r) => r.store));
    return rows.map((_, i) => (gh[i] == null && st[i] == null ? null : (gh[i] ?? 0) + (st[i] ?? 0)));
  }

  async function loadData() {
    const cards = [...root.querySelectorAll<HTMLElement>('.app[data-slug]')];
    const results = await Promise.allSettled(
      cards.map(async (el) => {
        const res = await fetch(`${DATA_BASE}${el.dataset.slug}.csv?t=${Date.now()}`, { cache: 'no-store' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return parseCsv(await res.text());
      }),
    );
    apps = cards.map((el, i) => {
      const r = results[i];
      return {
        el,
        slug: el.dataset.slug!,
        name: $('.name', el).textContent || el.dataset.slug!,
        seriesVar: el.dataset.series!,
        rows: r.status === 'fulfilled' && r.value.length > 0 ? r.value : null,
      };
    });
  }

  function buildTiles() {
    const live = apps.filter((a) => a.rows) as (App & { rows: Row[] })[];
    const github = live.reduce((s, a) => s + (lastKnown(a.rows, 'github') ?? 0), 0);
    const store = live.reduce((s, a) => s + (lastKnown(a.rows, 'store') ?? 0), 0);
    const total = github + store;

    // Grand combined series over the union of dates, for the 7-day delta.
    const dates = [...new Set(live.flatMap((a) => a.rows.map((r) => r.date)))].sort();
    const grand = dates.map((d) =>
      live.reduce((sum, a) => {
        const upTo = a.rows.filter((r) => r.date <= d);
        return sum + (lastKnown(upTo, 'github') ?? 0) + (lastKnown(upTo, 'store') ?? 0);
      }, 0),
    );
    let delta: number | null = null;
    if (dates.length > 1) {
      const lastDate = new Date(dates[dates.length - 1]);
      const cutoff = new Date(lastDate.getTime() - 7 * 86400000).toISOString().slice(0, 10);
      let ref = 0; // earliest recorded value if nothing predates the cutoff
      for (let i = 0; i < dates.length; i++) if (dates[i] <= cutoff) ref = i;
      delta = grand[grand.length - 1] - grand[ref];
    }

    const tiles = [
      { value: fmt(total), note: 'all apps, all channels' },
      { value: fmt(github), note: 'release downloads' },
      { value: fmt(store), note: 'acquisitions' },
      { value: delta == null ? '–' : `+${fmt(delta)}`, note: delta == null ? 'needs more data' : 'new installs', up: (delta ?? 0) > 0 },
    ];
    root.querySelectorAll<HTMLElement>('.tile').forEach((el, i) => {
      const t = tiles[i];
      const v = $('.value', el);
      v.textContent = t.value;
      v.classList.toggle('delta-up', !!t.up);
      $('.note', el).textContent = t.note;
    });
    $('#tiles').hidden = false;

    const allDates = live.flatMap((a) => a.rows.map((r) => r.date)).sort();
    const updated = allDates[allDates.length - 1];
    if (updated) $('#updated').textContent = `Updated ${updated}`;
  }

  function buildAppCards() {
    apps.forEach((a) => {
      const value = $('.value', a.el);
      const breakdown = $('.breakdown', a.el);
      const spark = $('.spark', a.el);
      value.hidden = false;
      if (!a.rows) {
        value.textContent = 'No data yet';
        value.classList.add('empty');
        breakdown.hidden = spark.hidden = true;
        return;
      }
      const gh = lastKnown(a.rows, 'github');
      const st = lastKnown(a.rows, 'store');
      value.textContent = fmt((gh ?? 0) + (st ?? 0));
      value.classList.remove('empty');
      breakdown.textContent = `GitHub ${fmt(gh)} · Store ${fmt(st)}`;
      breakdown.hidden = spark.hidden = false;
    });
  }

  // Direct labels at each line's end, nudged apart when they collide.
  const endLabels = {
    id: 'endLabels',
    afterDatasetsDraw(chart: Chart) {
      const labels: { text: string; x: number; y: number }[] = [];
      chart.data.datasets.forEach((ds: any, i) => {
        if (ds.skipEndLabel) return;
        const meta = chart.getDatasetMeta(i);
        for (let p = meta.data.length - 1; p >= 0; p--) {
          const el = meta.data[p];
          if (el && !isNaN(el.y) && ds.data[p] != null) {
            labels.push({ text: ds.label, x: el.x, y: el.y });
            break;
          }
        }
      });
      labels.sort((a, b) => a.y - b.y);
      for (let i = 1; i < labels.length; i++) {
        if (labels[i].y - labels[i - 1].y < 13) labels[i].y = labels[i - 1].y + 13;
      }
      const { ctx } = chart;
      ctx.save();
      ctx.font = `10.5px ${cssVar("--mono")}`;
      ctx.fillStyle = cssVar('--muted');
      ctx.textBaseline = 'middle';
      labels.forEach((l) => ctx.fillText(l.text, l.x + 7, l.y));
      ctx.restore();
    },
  };

  function buildMainChart() {
    const live = apps.filter((a) => a.rows) as (App & { rows: Row[] })[];
    if (live.length === 0) return;

    const dates = [...new Set(live.flatMap((a) => a.rows.map((r) => r.date)))].sort();
    const perApp = live.map((a) => {
      const combined = combinedSeries(a.rows);
      const byDate = new Map(a.rows.map((r, i) => [r.date, combined[i]]));
      // Forward-fill over the union axis so lines don't gap on days another
      // app recorded but this one didn't.
      let last: number | null = null;
      return dates.map((d) => (byDate.has(d) ? (last = byDate.get(d)!) : last));
    });
    const grand = dates.map((_, i) => perApp.reduce((s, series) => s + (series[i] ?? 0), 0));

    const fg = cssVar('--fg');
    const muted = cssVar('--muted');
    const faint = cssVar('--faint');
    const border = cssVar('--border');
    const bg = cssVar('--bg');
    const line = { borderWidth: 2, pointRadius: 0, pointHoverRadius: 4, tension: 0.2, spanGaps: true };
    // On phones the legend has to do; the end-label gutter would eat a third of the chart.
    const narrow = matchMedia('(max-width: 40rem)').matches;

    const datasets: any[] = live.map((a, i) => ({
      label: a.name, data: perApp[i], borderColor: cssVar(a.seriesVar, root), backgroundColor: cssVar(a.seriesVar, root), ...line,
    }));
    datasets.push({ label: 'Total', data: grand, borderColor: faint, backgroundColor: faint, borderDash: [6, 4], ...line });

    $('#chart-card').hidden = false;
    charts.push(
      new Chart($('#chart') as unknown as HTMLCanvasElement, {
        type: 'line',
        data: { labels: dates, datasets },
        plugins: narrow ? [] : [endLabels],
        options: {
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { right: narrow ? 8 : 124 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              position: 'top', align: 'start',
              labels: { color: muted, usePointStyle: true, pointStyle: 'circle', boxWidth: 7, boxHeight: 7, padding: 14 },
            },
            tooltip: {
              backgroundColor: bg, titleColor: fg, bodyColor: muted, borderColor: border, borderWidth: 1, padding: 10,
              itemSort: (a, b) => (b.parsed.y ?? 0) - (a.parsed.y ?? 0),
              callbacks: { label: (c) => ` ${c.dataset.label}: ${fmt(c.parsed.y)}` },
            },
          },
          scales: {
            x: { grid: { display: false }, border: { color: border }, ticks: { color: faint, maxTicksLimit: 6, maxRotation: 0 } },
            y: { beginAtZero: true, grid: { color: border }, border: { display: false }, ticks: { color: faint, precision: 0 } },
          },
        },
      }),
    );
  }

  function buildSparklines() {
    apps.forEach((a, i) => {
      if (!a.rows) return;
      const canvas = document.getElementById(`spark-${i}`) as HTMLCanvasElement | null;
      if (!canvas) return;
      charts.push(
        new Chart(canvas, {
          type: 'line',
          data: {
            labels: a.rows.map((r) => r.date),
            datasets: [{ data: combinedSeries(a.rows), borderColor: cssVar(a.seriesVar, root), borderWidth: 2, pointRadius: 0, tension: 0.3, spanGaps: true }],
          },
          options: {
            responsive: true, maintainAspectRatio: false, events: [],
            plugins: { legend: { display: false }, tooltip: { enabled: false } },
            scales: { x: { display: false }, y: { display: false } },
          },
        }),
      );
    });
  }

  function render() {
    charts.forEach((c) => c.destroy());
    charts = [];
    Chart.defaults.font.family = cssVar('--body');
    buildTiles();
    buildAppCards();
    buildSparklines();
    buildMainChart();
  }

  async function main() {
    const status = $('#status');
    try {
      await loadData();
    } catch (err) {
      status.textContent = `Couldn't load stats (${(err as Error).message}). Try again shortly.`;
      return;
    }
    if (!apps.some((a) => a.rows)) {
      status.textContent = 'No data recorded yet. Check back after the next daily run.';
      return;
    }
    status.hidden = true;
    render();
    // Charts read their colours from CSS, so redraw on either kind of theme change:
    // the OS switching, or the toggle writing data-theme on <html>.
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', render);
    matchMedia('(max-width: 40rem)').addEventListener('change', render);
    new MutationObserver(render).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }

  main();
</script>
