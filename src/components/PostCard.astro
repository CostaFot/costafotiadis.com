---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE, splitTitle, excerptOf, fmtDate, tagSlug } from '../lib/site';
// `beers` adds the count to the meta line (the ranking page); `hidden` keeps
// the card in the markup but out of view, for the ranking page's script to
// reveal when the live counts say so.
interface Props { post: CollectionEntry<'posts'>; beers?: number; hidden?: boolean }
const { post, beers, hidden } = Astro.props;
const { series, headline, mark } = splitTitle(post.data.title);
const href = `/${post.data.slug}/`;
const excerpt = excerptOf(post);
---
<li class="card" data-mark={mark} data-url={beers !== undefined ? `${SITE.url}/${post.data.slug}` : undefined} hidden={hidden}>
  <div class="card-grid">
    {series && <p class="eyebrow">{series}</p>}
    <h2><a href={href}>{headline}</a></h2>
    {excerpt && <p class="ex">{excerpt}</p>}
    <p class="meta">
      <time datetime={post.data.date_published.toISOString()}>{fmtDate(post.data.date_published)}</time>
      {post.data.tags.map((t) => <a class="tag" href={`/tag/${tagSlug(t)}/`}>{t.toLowerCase()}</a>)}
      {beers !== undefined && <span class="beers">{beers === 1 ? '1 beer' : `${beers} beers`} 🍺</span>}
    </p>
    {post.data.feature_image && (
      <a class="pv" href={href} tabindex="-1" aria-hidden="true">
        <Image src={post.data.feature_image} alt="" width={224} height={168} densities={[1, 2]} loading="lazy" />
      </a>
    )}
  </div>
</li>
