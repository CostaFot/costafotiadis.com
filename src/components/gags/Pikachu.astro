---
// Surprised Pikachu on Android RxJava in 5 minutes and Using Android
// RecyclerView in 2019: a click and he shouts his name, and the picture cuts
// in on his face once per syllable, the triple zoom of every dramatic meme
// edit. On "CHU" it is Thunderbolt: lightning off his cheeks, the picture
// flickering negative, then the Game Boy battle text says what happened.
import { stemOf } from './index';
interface Props { image: string }
---
<template class="gag-props" data-gag="pikachu" data-stem={stemOf(Astro.props.image)}></template>

<script>
  import { gag, canvasIn, copyOf, hitIn, play, prefetchOn, reducedMotion, stemsOf, TAU, span, out3, rand } from '../../lib/gags';

  type Pt = [number, number];
  // his face (the zooms' centre), his cheeks, each zoom (the last as close as
  // the frame takes eyes to mouth), and the battle text's box
  const SHOTS: Record<string, { w: number; h: number; face: Pt; cheeks: Pt[]; zooms: number[]; box: { x: number; y: number; w: number; h: number; px: number }; line: string }> = {
    // 800x450, the end of the RxJava tutorial ("wew lad you made it")
    '1-z9TNQimZn67nBK6UwP8b7g': {
      w: 800, h: 450, face: [440, 295], cheeks: [[250, 320], [640, 320]], zooms: [1.25, 1.55, 2],
      box: { x: 22, y: 330, w: 756, h: 104, px: 30 },
      line: 'PIKACHU learned RXJAVA! It hurt itself in its confusion!',
    },
    // 500x500, a Stack Overflow "marked as duplicate" banner over him
    '1-myD0lcpTpVrPWqLaVmma0g': {
      w: 500, h: 500, face: [285, 385], cheeks: [[163, 400], [396, 400]], zooms: [1.35, 1.9, 2.8],
      box: { x: 14, y: 392, w: 472, h: 94, px: 20 },
      line: "GRGARSIDE used MARK AS DUPLICATE! It's super effective!",
    },
  };
  const SOUND = '/gags/pikachu.mp3';
  const CUTS = [0.05, 0.35, 0.63];               // seconds: "pi", "ka", "CHU"
  const TILTS = [-3, 3, 0];
  const LET_GO = [1.3, 1.6];                     // the zoom eases back out between these
  const BOLTS = [0.63, 1.25];                    // Thunderbolt
  const TYPE = [1.05, 2.1];                      // the battle text types itself out
  const LENGTH = 4.4;

  for (const stem of stemsOf('pikachu')) {
    const S = SHOTS[stem];
    if (!S) continue;
    const g = gag(`pikachu-${stem}`, stem, S.w, 'pikachu-gag');
    if (!g) continue;
    const { img, layer } = g;
    const zoom = copyOf(img, 'zoom');
    zoom.style.transformOrigin = `${(S.face[0] / S.w) * 100}% ${(S.face[1] / S.h) * 100}%`;
    layer.append(zoom);
    const { ctx, fit, clear } = canvasIn(layer, S.w);
    const box = document.createElement('span');
    box.className = 'battle';
    Object.assign(box.style, {
      left: `${(S.box.x / S.w) * 100}%`, top: `${(S.box.y / S.h) * 100}%`,
      width: `${(S.box.w / S.w) * 100}%`, height: `${(S.box.h / S.h) * 100}%`,
    });
    box.style.setProperty('--px', String(S.box.px));
    const text = document.createElement('span');
    text.className = 'line';
    box.append(text);
    box.setAttribute('aria-live', 'polite');
    layer.append(box);
    const hit = hitIn(layer, 'Pikachu');
    prefetchOn(layer, SOUND);

    // Where the face is moved to at each zoom: towards the middle of the
    // frame, but never so far that the picture's edge comes into view (with
    // room kept for the tilt).
    const shift = (zoom: number): Pt => [0, 1].map((k) => {
      const size = k ? S.h : S.w, f = S.face[k], z = zoom - 0.1;
      const want = size / 2 - f, lo = (size - f) * (1 - z), hi = f * (z - 1);
      return Math.min(hi, Math.max(lo, want));
    }) as Pt;
    const view = (t: number) => {
      const n = CUTS.filter((c) => t >= c).length;
      if (!n) return { z: 1, d: [0, 0] as Pt, tilt: 0 };
      // each cut lands a touch past its zoom and settles in 60 ms
      const punch = 1 + 0.08 * (1 - out3(span(t, CUTS[n - 1], CUTS[n - 1] + 0.06)));
      const back = out3(span(t, LET_GO[0], LET_GO[1]));
      const z = 1 + (S.zooms[n - 1] * punch - 1) * (1 - back);
      const [dx, dy] = shift(S.zooms[n - 1]);
      return { z, d: [dx * (1 - back), dy * (1 - back)] as Pt, tilt: TILTS[n - 1] * (1 - back) };
    };

    // A jagged bolt from a point, heading off at an angle, forking now and then.
    const bolt = (x: number, y: number, a: number, len: number, width: number, depth = 0) => {
      const pts: Pt[] = [[x, y]];
      const step = S.w / 26;
      for (let d = 0; d < len; d += step) {
        a += rand(-0.5, 0.5);
        x += Math.cos(a) * step;
        y += Math.sin(a) * step;
        pts.push([x, y]);
        if (depth < 1 && Math.random() < 0.12) bolt(x, y, a + rand(-0.9, 0.9), len * 0.4, width * 0.6, depth + 1);
      }
      // a dark edge, then the yellow, then the white-hot core, so it reads on yellow
      for (const [w, style, blur] of [[width * 5, 'rgba(20,24,90,0.55)', 0], [width * 2.6, 'rgba(255,214,40,0.95)', 16], [width, '#fffef2', 4]] as const) {
        ctx.lineWidth = w;
        ctx.strokeStyle = style;
        ctx.shadowColor = 'rgba(255,230,80,0.9)';
        ctx.shadowBlur = blur;
        ctx.beginPath();
        pts.forEach(([px, py], i) => (i ? ctx.lineTo(px, py) : ctx.moveTo(px, py)));
        ctx.stroke();
      }
    };
    // The move strobes in 50 ms frames: a white flash, dark, negative, dark.
    const strobe = (t: number) => (t >= BOLTS[0] && t < BOLTS[1] ? Math.floor((t - BOLTS[0]) / 0.05) % 4 : -1);
    const thunder = (t: number, z: number, d: Pt) => {
      const k = span(t, BOLTS[0], BOLTS[0] + 0.05) * (1 - span(t, BOLTS[1] - 0.2, BOLTS[1]));
      if (k <= 0) return;
      ctx.save();
      ctx.globalAlpha = k;
      ctx.fillStyle = strobe(t) === 0 ? 'rgba(255,253,225,0.55)' : 'rgba(10,14,70,0.42)';
      ctx.fillRect(0, 0, S.w, S.h);
      ctx.lineJoin = ctx.lineCap = 'round';
      // the cheeks where the zoom has put them
      const at = ([px, py]: Pt): Pt => [S.face[0] + (px - S.face[0]) * z + d[0], S.face[1] + (py - S.face[1]) * z + d[1]];
      S.cheeks.map(at).forEach(([cx, cy], side) => {
        const gl = ctx.createRadialGradient(cx, cy, 0, cx, cy, S.w * 0.16);
        gl.addColorStop(0, 'rgba(255,245,160,0.9)');
        gl.addColorStop(1, 'rgba(255,200,40,0)');
        ctx.globalCompositeOperation = 'lighter';
        ctx.fillStyle = gl;
        ctx.fillRect(cx - S.w * 0.16, cy - S.w * 0.16, S.w * 0.32, S.w * 0.32);
        ctx.globalCompositeOperation = 'source-over';
        for (let i = 0; i < 4; i++) bolt(cx, cy, (side ? 0 : Math.PI) + rand(-1.6, 1.6), S.w * rand(0.45, 0.95), S.w / 180);
      });
      // and a couple coming down out of the sky onto him
      for (let i = 0; i < 2; i++) bolt(S.w * rand(0.15, 0.85), -10, Math.PI / 2 + rand(-0.35, 0.35), S.h * 1.1, S.w / 150);
      ctx.restore();
    };

    let running = false, start = 0, still = false, lastBolt = -1;
    const frame = (now: number) => {
      const t = (now - start) / 1000;
      if (t >= LENGTH) {
        clear();
        layer.classList.remove('live', 'typing');
        zoom.style.transform = zoom.style.filter = '';
        running = false;
        return;
      }
      const { z, d, tilt } = still ? { z: 1, d: [0, 0] as Pt, tilt: 0 } : view(t);
      zoom.style.transform = `translate(${(d[0] / S.w) * 100}%, ${(d[1] / S.h) * 100}%) scale(${z}) rotate(${tilt}deg)`;
      // CHU fries the picture, and flickers it negative while the bolts are out
      const fried = t >= CUTS[2] && t < LET_GO[1] + 0.3;
      const negative = !still && strobe(t) === 2;
      zoom.style.filter = negative ? 'invert(1) hue-rotate(180deg) saturate(1.6)' : fried ? 'saturate(1.6) contrast(1.2)' : '';
      // bolts are redrawn every 50 ms, so they crackle rather than crawl
      if (!still && Math.floor(t / 0.05) !== lastBolt) {
        lastBolt = Math.floor(t / 0.05);
        clear();
        thunder(t, z, d);
      }
      // the battle text, a letter at a time
      if (t >= TYPE[0]) {
        layer.classList.add('typing');
        const n = still ? S.line.length : Math.ceil(S.line.length * span(t, TYPE[0], TYPE[1]));
        if (text.textContent!.length !== n) text.textContent = S.line.slice(0, n);
        box.style.opacity = String(1 - span(t, LENGTH - 0.35, LENGTH));
      }
      requestAnimationFrame(frame);
    };

    hit.addEventListener('click', () => {
      if (running) return;
      running = true;
      still = reducedMotion();
      lastBolt = -1;
      g.found();
      play(SOUND);
      fit();
      text.textContent = '';
      box.style.opacity = '1';
      layer.classList.add('live');
      start = performance.now();
      requestAnimationFrame(frame);
    });
  }
</script>

<style is:global>
  .pikachu-gag .zoom { will-change: transform; }
  .pikachu-gag .battle {
    position: absolute; box-sizing: border-box; display: flex; align-items: center; pointer-events: none;
    padding: 0 calc(22px * var(--s, 0.5)); visibility: hidden;
    background: #f8f8f0; color: #202020; border-radius: calc(10px * var(--s, 0.5));
    border: calc(6px * var(--s, 0.5)) double #303848;
    box-shadow: 0 0 0 calc(3px * var(--s, 0.5)) #f8f8f0, 0 calc(6px * var(--s, 0.5)) calc(18px * var(--s, 0.5)) rgb(0 0 0 / 0.35);
    font: 700 calc(var(--px) * 1px * var(--s, 0.5)) / 1.35 "Press Start 2P", "Pokemon GB", ui-monospace, "JetBrains Mono", monospace;
    text-transform: none; letter-spacing: 0.02em;
  }
  .pikachu-gag.typing .battle { visibility: visible; }
  .pikachu-gag .battle .line { flex: 1; }
</style>
