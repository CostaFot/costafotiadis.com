---
// Pagefind indexes dist/ after `astro build`; the UI script is loaded on
// first open so pages that never search pay nothing for it.
---
<button type="button" id="search-open">search</button>

<dialog id="search" aria-label="Search posts">
  <div class="box">
    <div id="pagefind"></div>
    <p class="hint" hidden>Search is built with the site, so it only works after <code>npm run build</code>. Not in dev.</p>
    <button type="button" class="close" id="search-close">esc</button>
  </div>
</dialog>

<style>
  dialog { border: 0; padding: 1.8rem 0 0; background: transparent; overflow: visible; max-width: min(40rem, 100vw - 2rem); width: 100%; }
  dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
  .box { position: relative; background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; }
  .close { color: #fff; border-color: rgba(255,255,255,0.4);
    position: absolute; top: -1.7rem; right: 0;
    background: none; border: 1px solid var(--border); border-radius: 4px;
    font: 500 0.7rem/1 var(--mono); padding: 0.3rem 0.45rem; cursor: pointer;
  }
  .close:hover { color: var(--accent); border-color: var(--accent); }
  .hint { margin: 0.5rem 0 0; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  #pagefind { --pagefind-ui-scale: 0.9; --pagefind-ui-primary: var(--accent); --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg); --pagefind-ui-border: var(--border); --pagefind-ui-tag: var(--soft);
    --pagefind-ui-border-width: 1px; --pagefind-ui-border-radius: 6px; --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-font: var(--body); }
  #pagefind :global(.pagefind-ui__search-input) { padding-right: 3.5rem; }
  #pagefind :global(.pagefind-ui__result-title) { font-family: var(--display); font-weight: 800; letter-spacing: -0.02em; }
  #pagefind :global(.pagefind-ui__result-excerpt) { font-size: 0.9rem; }
  #pagefind :global(mark) { background: var(--accent-soft); color: inherit; }
</style>

<script>
  const dialog = document.getElementById('search') as HTMLDialogElement;
  const hint = dialog.querySelector('.hint') as HTMLElement;
  let ready: Promise<void> | null = null;

  function load() {
    if (ready) return ready;
    ready = new Promise<void>((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      const s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = () => {
        // @ts-ignore provided by pagefind-ui.js
        new PagefindUI({ element: '#pagefind', showSubResults: true, showImages: false, resetStyles: false, autofocus: true });
        resolve();
      };
      s.onerror = () => reject(new Error('pagefind not built'));
      document.head.appendChild(s);
    });
    return ready;
  }

  async function open() {
    dialog.showModal();
    try {
      await load();
      (dialog.querySelector('input') as HTMLInputElement | null)?.focus();
    } catch {
      hint.hidden = false;
    }
  }

  document.getElementById('search-open')!.addEventListener('click', open);
  document.getElementById('search-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  document.addEventListener('keydown', (e) => {
    if ((e.key === '/' && !dialog.open && !(e.target as HTMLElement).closest('input, textarea')) || ((e.metaKey || e.ctrlKey) && e.key === 'k')) {
      e.preventDefault();
      open();
    }
  });
</script>
